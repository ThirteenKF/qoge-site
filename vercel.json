{
  "rewrites": [
    {
      "source": "/m",
      "destination": "/api/share"
    },
    {
      "source": "/weekly",
      "destination": "/api/weekly"
    },
    {
      "source": "/weekly/:n",
      "destination": "/api/weekly?n=:n"
    }
  ],
  "functions": {
    "api/quai.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/quai?save=1",
      "schedule": "50 23 * * *"
    }
  ]
}
